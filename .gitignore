# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# PROMPT-11 Bagian 4 — Rhubarb Lip Sync CLI binary (~150MB extracted),
# downloaded from github.com/DanielSWolf/rhubarb-lip-sync releases into
# tools/. Same local-only-tool pattern as VOICEVOX: needed to RUN
# scripts/generate-lipsync.ts, never needed at app runtime, far too
# large to commit. If missing, re-download the Windows build and
# extract to tools/Rhubarb-Lip-Sync-<version>-Windows/.
/tools/

# Playwright E2E — saved session (auth-setup.ts) and run artifacts.
# The storage state holds a live Supabase session cookie for the E2E
# test account, so it must never be committed even though it's not
# technically a ".env*" file.
/.auth/
/.screenshots/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
